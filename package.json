{
  "name": "onsystem",
  "version": "0.5.0",
  "mcpName": "io.github.dgesteves/onsystem",
  "description": "Keeps coding agents on your design system: it knows your real components, props, variants and tokens, catches the moment an agent invents one and has it fix it, and the same check gates your PRs. Local, zero config, works alongside @shadcn/lint.",
  "keywords": [
    "design-system",
    "design-system-lint",
    "agent-guardrails",
    "linter",
    "lint",
    "eslint",
    "eslint-plugin",
    "react",
    "shadcn",
    "cva",
    "tailwindcss",
    "design-tokens",
    "accessibility",
    "ci",
    "claude-code",
    "claude-code-plugin",
    "cursor",
    "ai-agents",
    "mcp",
    "model-context-protocol"
  ],
  "homepage": "https://onsystem.vercel.app",
  "bugs": "https://github.com/dgesteves/onsystem/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dgesteves/onsystem.git"
  },
  "license": "MIT",
  "author": "Diogo Esteves (https://github.com/dgesteves)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./eslint": {
      "types": "./dist/eslint.d.ts",
      "default": "./dist/eslint.js"
    },
    "./schema.json": "./schema.json",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "onsystem": "dist/cli.js"
  },
  "files": [
    "dist",
    "schema.json"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@11.6.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown && node scripts/build-schema.mjs",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "pack-test": "node scripts/pack-test.mjs",
    "assets": "node scripts/build-assets.mjs",
    "palette": "node scripts/build-palette.mjs",
    "sync-plugins": "node scripts/sync-plugins.mjs",
    "corpus": "node scripts/corpus.mjs",
    "demo:check": "cd examples/shadcn-demo && node ../../dist/cli.js check \"app/**/*.tsx\"",
    "demo:inspect": "node dist/cli.js inspect --root examples/shadcn-demo",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-versions.mjs",
    "release": "pnpm build && changeset publish",
    "prepack": "node scripts/npm-readme.mjs prepack",
    "postpack": "node scripts/npm-readme.mjs postpack"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "culori": "^4.0.2",
    "postcss": "^8.5.29",
    "stemmer": "^2.0.1",
    "tinyglobby": "^0.2.17",
    "typescript": "~6.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/culori": "^4.0.1",
    "@types/node": "^24.19.1",
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-v9": "npm:eslint@9.39.5",
    "geist": "^1.7.2",
    "globals": "^17.13.0",
    "opentype.js": "^2.0.0",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "react-aria-components": "^1.21.1",
    "tailwind-variants": "^3.3.1",
    "tsdown": "^0.23.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
